<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardUseCompatPadding="true"
        app:cardCornerRadius="30dp"
        tools:context=".SplashActivity.splashFrag.SelectProfileDialog">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="15dp"
            >

            <ImageView
                android:id="@+id/maleA"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_margin="5dp"
                android:layout_marginEnd="5dp"
                android:src="@drawable/male_adult" />

            <ImageView
                android:id="@+id/maleK"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_margin="5dp"
                android:layout_toEndOf="@id/maleA"
                android:src="@drawable/male_kid" />

            <ImageView
                android:id="@+id/femaleA"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_margin="5dp"
                android:layout_below="@id/maleA"
                android:src="@drawable/female_adult" />

            <ImageView
                android:id="@+id/femaleK"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_margin="5dp"
                android:layout_below="@id/maleK"
                android:layout_toEndOf="@id/femaleA"
                android:src="@drawable/female_kid" />

        </RelativeLayout>

    </androidx.cardview.widget.CardView>
</layout>