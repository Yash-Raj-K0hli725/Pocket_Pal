<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">
    <fragment
        android:id="@+id/introPage"
        android:name="com.example.pocketpal.SplashActivity.splashFrag.introPage"
        android:label="introPage1"
        tools:layout="@layout/fragment_intro_page">
        <action
            android:id="@+id/action_introPage_to_budgetInfo"
            app:destination="@id/budgetInfo" />
    </fragment>
    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.pocketpal.SplashActivity.splashFrag.RegisterFragment"
        android:label="RegisterFragment"
        tools:layout="@layout/fragment_register"
        >
        <argument
            android:name="budget"
            app:argType="com.example.pocketpal.database.Budget" />
    </fragment>
    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.pocketpal.SplashActivity.splashFrag.SplashFragment"
        android:label="SplashFragment"
        tools:layout="@layout/fragment_splash"
        >
        <action
            android:id="@+id/action_splashFragment_to_introPage"
            app:destination="@id/introPage"
            app:enterAnim="@anim/nav_fade_in"
            app:exitAnim="@anim/nav_fade_out"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/budgetInfo"
        android:name="com.example.pocketpal.SplashActivity.splashFrag.BudgetInfo"
        android:label="fragment_budget_info"
        tools:layout="@layout/fragment_budget_info" >
        <action
            android:id="@+id/action_budgetInfo_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_budgetInfo_to_selectProfileDialog"
            app:destination="@id/selectProfileDialog" />
    </fragment>
    <dialog
        android:id="@+id/selectProfileDialog"
        android:name="com.example.pocketpal.SplashActivity.splashFrag.SelectProfileDialog"
        android:label="SelectProfileDialog"
        tools:layout="@layout/fragment_select_profile_dialog"
        />
</navigation>